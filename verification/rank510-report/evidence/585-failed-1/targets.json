        {
          "id": "uniform-bound",
          "description": "One positive absolute real C works for every finite simple graph on n >= 2 vertices, chi/sigma <= C sqrt(n)/log(n), with attained positive maximum sigma and no density or connectivity premise.",
          "targets": [
            "t54",
            "t60",
