  "problems": [
    {
      "id": "JSP-000728",
      "source": "https://arxiv.org/html/1409.5661v1#S1",
      "requirements": [
        {
          "id": "finite-families",
          "description": "All sum-free subsets and all inclusion-maximal sum-free subsets of the entire finite interval [1,N], allowing x=y in x+y=z.",
          "targets": [
            "JSP000728.mem_maximalSets",
            "JSP000728.exists_maximal_extension",
            "JSP000728.sumFree_iff_upstream",
            "JSP000728.maximalSumFree_iff_upstream",
            "JSP000728.maximalSets_eq_upstream",
            "JSP000728.maximalSets_card_eq_upstream",
            "JSP000728.allSumFreeSets_eq_upstream",
            "Verify728.sumFree_iff",
            "Verify728.maximal_iff",
            "Verify728.maximal_count",
            "Verify728.all_count"
          ],
          "coverage": "pending"
        },
        {
          "id": "all-n-lower",
          "description": "For every natural N including zero, 2^floor(N/4) is at most the number M(N) of maximal sum-free subsets.",
          "targets": [
            "JSP000728.exists_maximal_extension",
            "JSP000728.pick_bounds",
            "JSP000728.pick_sum_ne",
            "JSP000728.seed_subset",
            "JSP000728.seed_sumFree",
            "JSP000728.different_choices_incompatible",
            "JSP000728.lower_bound_multiple",
            "JSP000728.cameron_erdos_lower_bound",
            "JSP000728.upstream_count_lower_bound",
            "Verify728.intended"
          ],
          "coverage": "pending"
        },
        {
          "id": "benchmark-upper",
          "description": "The claimed imported upper bound M(N)=o(2^(N/2)) and eventual bound with a fixed exponent below 1/2.",
          "targets": [
            "JSP000728.maximalCount_isLittleO_benchmark",
            "JSP000728.maximalCount_exponential_bound",
            "Verify728.upstream_littleO",
            "Verify728.upstream_exponential",
            "Verify728.upstream_exponent_lt_half",
            "Erdos877.erdos_877",
            "Erdos877.erdos_877_exponential_bound",
            "Erdos877.resolutionExponent_lt_half"
          ],
          "coverage": "pending"
        },
        {
          "id": "all-count-benchmark",
          "description": "All subsets of the upper half are counted; F(N)>=2^ceil(N/2)>=2^(N/2).",
          "targets": [
            "JSP000728.upperHalf_powerset_subset",
            "JSP000728.allSumFreeSets_lower_bound",
            "JSP000728.benchmark_le_allSumFreeSets"
          ],
          "coverage": "pending"
        },
        {
          "id": "relative-negligibility",
          "description": "The original question M(N)=o(F(N)), equivalently here M(N)/F(N) tends to zero as N tends to infinity.",
          "targets": [
            "JSP000728.maximalCount_isLittleO_allCount",
            "JSP000728.maximal_to_all_ratio_tendsto_zero",
            "JSP000728.jsp_000728",
            "Verify728.intended"
          ],
          "coverage": "pending"
        },
        {
          "id": "fixed-exponential-saving",
          "description": "There exists one real delta>0, independent of N, such that eventually M(N)<=F(N)/2^(delta*N).",
          "targets": [
            "JSP000728.relative_exponential_saving",
            "JSP000728.jsp_000728",
            "Verify728.intended"
          ],
          "coverage": "pending"
        }
      ]
    }
