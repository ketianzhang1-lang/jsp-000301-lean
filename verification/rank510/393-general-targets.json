  "problems": [
    {
      "id": "JSP-000393",
      "source": "https://www.erdosproblems.com/485",
      "requirements": [
        {
          "id": "minimum",
          "description": "The infimum is the attained minimum of the actual square-support cardinality for every rational polynomial with exactly k nonzero terms, including k=0 and k=1.",
          "targets": [
            "t2",
            "t5"
          ],
          "coverage": "pending"
        },
        {
          "id": "lower",
          "description": "For all support sizes k, the minimum tends to infinity with no unproved Schinzel assumption; equivalent uniform threshold is valid for every rational polynomial.",
          "targets": [
            "t3",
            "t4",
            "t11",
            "t12"
          ],
          "coverage": "pending"
        },
        {
          "id": "family",
          "description": "For every natural k, construct an integer polynomial with 13^k nonzero terms and 12^k nonzero terms in its square, with no exponent collisions.",
          "targets": [
            "t0",
            "t1",
            "t6"
          ],
          "coverage": "pending"
        },
        {
          "id": "minimum-upper",
          "description": "Prove the genuine rational minimum bound f(13^k) <= 12^k using a support-preserving integer-to-rational coefficient map.",
          "targets": [
            "t5",
            "t6",
            "t7"
          ],
          "coverage": "pending"
        },
        {
          "id": "small-ratio",
          "description": "For every natural ratio factor M and every cutoff N, some n>=N has M*f(n)<n.",
          "targets": [
            "t8",
            "t12"
          ],
          "coverage": "pending"
        },
        {
          "id": "integer-threshold",
          "description": "The proved rational Schinzel bound implies the submitted explicit integer-polynomial estimate and uniform threshold.",
          "targets": [
            "t9",
            "t10"
          ],
          "coverage": "pending"
        },
        {
          "id": "complex-minimum",
          "description": "Original complex coefficient domain, exact actual squared-support minimum, attained for every k, including correct zero/one cases.",
          "targets": [
            "g3",
            "g4",
            "b0",
            "b1",
            "b4"
          ],
          "coverage": "pending"
        },
        {
          "id": "original-complex-coefficients",
          "description": "All complex polynomials are included: the full Schinzel lower bound and minimum divergence follow from a proved characteristic-zero-field induction, not merely a rational approximation or an assumed reduction.",
          "targets": [
            "g0",
            "g1",
            "g2",
            "g5",
            "g9",
            "g10",
            "b2",
            "b3"
          ],
          "coverage": "pending"
        },
        {
          "id": "general-upper-ratio",
          "description": "The retained original integer family embeds injectively in every characteristic-zero field; prove exact counts, true minimum upper bounds and arbitrary-cutoff small-ratio witnesses for complex coefficients as well.",
          "targets": [
            "g6",
            "g7",
            "g8",
            "g9",
            "b2"
          ],
          "coverage": "pending"
        }
      ]
    }
