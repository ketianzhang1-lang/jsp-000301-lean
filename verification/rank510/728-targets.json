      "requirements": [
        {
          "id": "finite-families",
          "description": "All sum-free subsets and all inclusion-maximal sum-free subsets of the entire finite interval [1,N], allowing x=y in x+y=z.",
          "targets": [
            "t008",
            "t009",
            "t017",
            "t018",
            "t019",
            "t020",
            "t021",
            "t003",
            "t004",
            "t005",
            "t006"
          ],
          "coverage": "pending"
        },
        {
          "id": "all-n-lower",
          "description": "For every natural N including zero, 2^floor(N/4) is at most the number M(N) of maximal sum-free subsets.",
          "targets": [
            "t009",
            "t010",
            "t011",
            "t012",
            "t013",
            "t014",
            "t015",
            "t016",
            "t027",
            "t007"
          ],
          "coverage": "pending"
        },
        {
          "id": "benchmark-upper",
          "description": "The claimed imported upper bound M(N)=o(2^(N/2)) and eventual bound with a fixed exponent below 1/2.",
          "targets": [
            "t025",
            "t026",
            "t000",
            "t001",
            "t002",
            "t032",
            "t033",
            "t034"
          ],
          "coverage": "pending"
        },
        {
          "id": "all-count-benchmark",
          "description": "All subsets of the upper half are counted; F(N)>=2^ceil(N/2)>=2^(N/2).",
          "targets": [
            "t022",
            "t023",
            "t024"
          ],
          "coverage": "pending"
        },
        {
          "id": "relative-negligibility",
          "description": "The original question M(N)=o(F(N)), equivalently here M(N)/F(N) tends to zero as N tends to infinity.",
          "targets": [
            "t028",
            "t029",
            "t031",
            "t007"
          ],
          "coverage": "pending"
        },
        {
          "id": "fixed-exponential-saving",
          "description": "There exists one real delta>0, independent of N, such that eventually M(N)<=F(N)/2^(delta*N).",
          "targets": [
            "t030",
            "t031",
            "t007"
          ],
          "coverage": "pending"
        }
      ]
    }
