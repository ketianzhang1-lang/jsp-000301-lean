          ],
          "coverage": "pending"
        },
        {
          "id": "asymptotic-original",
          "description": "The normalized minimum f(n,4,5)/n tends to 5/6 as n tends through all natural numbers to infinity.",
          "targets": [
            "t038",
            "t039",
            "t043",
            "t044",
            "t045",
            "t052"
          ],
          "coverage": "pending"
        },
        {
          "id": "eventual-construction",
          "description": "For every real epsilon>0, actual admissible colourings exist for every sufficiently large n with palette below (5/6+epsilon)n.",
          "targets": [
            "t040",
            "t054"
          ],
          "coverage": "pending"
        },
        {
          "id": "finite-lower",
          "description": "For all n>=4 the stronger strict finite bound 5(n-1)<6f(n,4,5) and integer rounding are proved.",
