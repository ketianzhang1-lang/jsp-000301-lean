      "id": "JSP-000140",
      "source": "https://arxiv.org/abs/2207.02920v1",
      "requirements": [
        {
          "id": "unordered-edges",
          "description": "Colours assigned to genuine unordered edges of the complete simple graph, with at least five distinct colours on every four-vertex embedding.",
          "targets": [
            "t022",
            "t023",
            "t024",
            "t025",
            "t026",
            "t027",
            "t028",
            "t029",
            "t046"
          ],
          "coverage": "pending"
        },
        {
          "id": "attained-minimum",
          "description": "The standard finite palette minimum exists and is attained for all natural n; pair-model equivalence is restricted correctly to n>=2.",
          "targets": [
            "t030",
            "t031",
            "t032",
            "t033",
            "t034",
            "t035",
            "t047",
            "t048",
