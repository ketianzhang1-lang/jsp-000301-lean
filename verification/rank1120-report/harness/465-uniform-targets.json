  "problems": [
    {
      "id": "JSP-000465",
      "source": "https://www.erdosproblems.com/575",
      "requirements": [
        {
          "id": "ordinary-family-extremal",
          "description": "Maximum edge count over all n-vertex simple graphs avoiding every forbidden member as an ordinary, not induced, subgraph; singleton agrees with Mathlib.",
          "targets": [
            "t000",
            "t012",
            "t013"
          ],
          "coverage": "pending"
        },
        {
          "id": "attained-all-orders",
          "description": "The family-free class is nonempty and the maximum is attained by an actual graph at every natural order including zero.",
          "targets": [
            "t001",
            "t014"
          ],
          "coverage": "pending"
        },
        {
          "id": "fixed-connected-bipartite-cyclic-family",
          "description": "One finite nonempty forbidden family is fixed before all asymptotic parameters; every member is connected, bipartite and contains a cycle.",
          "targets": [
            "t004",
            "t006",
            "t015"
          ],
          "coverage": "pending"
        },
        {
          "id": "uniform-separation",
          "description": "For every real K>0, one threshold N works simultaneously for all n>=N and all family members with strict separation.",
          "targets": [
            "t002",
            "t003",
            "t004",
            "t015"
          ],
          "coverage": "pending"
        },
        {
          "id": "full-compactness-negation",
          "description": "Negates both the catalog bipartite-member conjecture and the strengthened forest-excluding compactness conjecture.",
          "targets": [
            "t005",
            "t006",
            "t016",
            "t017"
          ],
          "coverage": "pending"
        },
        {
          "id": "uniform-positive-ratios",
          "description": "Simultaneous positivity and arbitrarily small real ratios for every family member at all large host orders; denominator positivity excludes division-by-zero vacuity.",
          "targets": [
            "t007",
            "t008",
            "t018"
          ],
          "coverage": "pending"
        },
        {
          "id": "adaptive-selector",
          "description": "The member may vary arbitrarily with n, membership is only eventually required, and the literal extremal ratio tends to zero in the usual real topology; no adaptive constant-factor comparison exists.",
          "targets": [
            "t009",
            "t010",
            "t011",
            "t019",
            "t020"
          ],
          "coverage": "pending"
        }
      ]
    }
  ],
