          ],
          "coverage": "pending"
        },
        {
          "id": "density-one",
          "description": "Ordinary natural density one of successful prime-gap indices; literal count among indices 0,...,N-1 divided by N tends to one, without an added analytic hypothesis.",
          "targets": [
            "t029",
            "t031",
            "t034",
            "t035",
            "t039",
            "t041"
          ],
          "coverage": "pending"
        },
        {
          "id": "density-zero",
          "description": "Complementary exceptional prime-gap indices have ordinary natural density zero and the literal prefix-count ratio tends to zero.",
          "targets": [
            "t028",
