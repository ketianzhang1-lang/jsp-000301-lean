'JSP000925Strict.strict_algebra' depends on axioms: [propext, Classical.choice, Quot.sound]
'JSP000925Strict.phase_second_positive' depends on axioms: [propext, Classical.choice, Quot.sound]
'JSP000925Strict.phase_strict_convex' depends on axioms: [propext, Classical.choice, Quot.sound]
'JSP000925Strict.canonical_strict' depends on axioms: [propext, Classical.choice, Quot.sound]
'JSP000925Strict.strict_gap_theorem' depends on axioms: [propext, Classical.choice, Quot.sound]
