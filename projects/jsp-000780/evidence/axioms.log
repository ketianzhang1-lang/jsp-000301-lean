def JSP000780.OriginalSolutions : ℕ → Set (Finset ℕ) :=
fun r =>
  {S | S.card = r - 2 ∧ S.gcd id = 1 ∧ JSP000780.FactorFull r (∑ n ∈ S, n) ∧ ∀ n ∈ S, 0 < n ∧ JSP000780.FactorFull r n}
def JSP000780.Solution : Finset ℕ → Prop :=
fun S => S.card = 4 ∧ S.gcd id = 1 ∧ JSP000780.SixFull (∑ n ∈ S, n) ∧ ∀ n ∈ S, 0 < n ∧ JSP000780.SixFull n
def JSP000780.base : ℕ → ℕ :=
fun t => 30 * (t + 11) + 1
def JSP000780.terms : ℕ → Finset ℕ :=
fun t =>
  have x := JSP000780.base t ^ 6;
  have y := 30 ^ 6;
  {(x - y) ^ 6, 12 * x ^ 5 * y, 40 * x ^ 3 * y ^ 3, 12 * x * y ^ 5}
def JSP000780.total : ℕ → ℕ :=
fun t => (JSP000780.base t ^ 6 + 30 ^ 6) ^ 6
'JSP000780.solution_for_every_parameter' depends on axioms: [propext, Classical.choice, Quot.sound]
